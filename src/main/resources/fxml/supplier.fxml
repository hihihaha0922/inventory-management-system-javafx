<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jack.inventory.controller.SupplierController">
   <children>
      <BorderPane layoutX="167.0" layoutY="127.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label text="Supplier Management" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </Label>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0">
                     <children>
                        <TextField fx:id="companyNameField" prefWidth="150.0" promptText="Company Name" />
                        <TextField fx:id="contactPersonField" prefWidth="400.0" promptText="Contact Person" />
                        <TextField fx:id="phoneField" prefWidth="400.0" promptText="Phone" />
                        <TextField fx:id="emailField" prefWidth="400.0" promptText="Email" />
                        <TextField fx:id="addressField" prefWidth="400.0" promptText="Address" />
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
                           <children>
                              <Button fx:id="addButton" mnemonicParsing="false" onAction="#addSupplier" prefWidth="150.0" text="Add" />
                              <Button fx:id="updateButton" mnemonicParsing="false" onAction="#updateSupplier" prefWidth="150.0" text="Update" />
                              <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteSupplier" prefWidth="150.0" text="Delete" />
                              <Button fx:id="clearButton" mnemonicParsing="false" onAction="#clearFields" prefWidth="150.0" text="Clear" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" left="20.0" right="20.0" />
                           </padding>
                        </HBox>
                     </children>
                  </VBox>
                  <TextField fx:id="searchField" prefWidth="300.0" promptText="Search supplier..." />
                  <TableView fx:id="supplierTable" prefHeight="450.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                      <TableColumn fx:id="companyNameColumn" prefWidth="100.0" text="Company Name" />
                        <TableColumn fx:id="contactPersonColumn" prefWidth="100.0" text="Contact Person" />
                        <TableColumn fx:id="phoneColumn" prefWidth="100.0" text="Phone" />
                        <TableColumn fx:id="emailColumn" prefWidth="120.0" text="Email" />
                        <TableColumn fx:id="addressColumn" prefWidth="120.0" text="Address" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
