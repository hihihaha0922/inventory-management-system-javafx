<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jack.inventory.controller.ProductController">
   <children>
      <BorderPane layoutX="167.0" layoutY="127.0" prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <Label text="Product Management" BorderPane.alignment="CENTER">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </Label>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <children>
                        <TextField fx:id="nameField" promptText="Product Name" />
                        <TextField fx:id="categoryField" layoutX="20.0" layoutY="20.0" promptText="Category" />
                        <TextField fx:id="priceField" layoutX="179.0" layoutY="20.0" promptText="Price" />
                        <TextField fx:id="quantityField" layoutX="339.0" layoutY="20.0" promptText="Quantity" />
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#addProduct" prefWidth="150.0" text="Add" />
                        <Button fx:id="updateButton" layoutX="569.0" layoutY="20.0" mnemonicParsing="false" onAction="#updateProduct" prefWidth="150.0" text="Update" />
                        <Button fx:id="deleteButton" layoutX="576.0" layoutY="20.0" mnemonicParsing="false" onAction="#deleteProduct" prefWidth="150.0" text="Delete" />
                        <Button fx:id="clearButton" layoutX="576.0" layoutY="20.0" mnemonicParsing="false" onAction="#clearFields" prefWidth="150.0" text="Clear" />
                     </children>
                  </HBox>
                  <TextField fx:id="searchField" prefWidth="300.0" promptText="Search product..." />
                  <TableView fx:id="productTable" prefHeight="450.0" prefWidth="200.0">
                    <columns>
                      <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
                      <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Product Name" />
                        <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
                        <TableColumn fx:id="priceColumn" prefWidth="75.0" text="Price" />
                        <TableColumn fx:id="quantityColumn" prefWidth="75.0" text="Quantity" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
